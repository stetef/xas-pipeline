# Site configuration for the ORCA/CORVUS pipeline.
#
# Copy this file to ".env" (which is gitignored) and edit the values for your
# machine. The bash job/wrapper templates source it (set -a; source .env) and the
# Python entry points load it via pipeline_env.py, so paths live here instead of
# being hardcoded in the scripts. Anything left unset falls back to the
# scheduler-appropriate default baked into each template, so an absent .env keeps
# the old behavior.
#
# Format: plain KEY=VALUE (no spaces around '='). Values already exported in the
# environment are never overridden.

# ============================================================================
# SLURM / s3df (SLAC) -- the values currently in use
# ============================================================================
PIPELINE_OPENMPI_ROOT=/sdf/group/ssrl/sarangi/sw/openmpi
PIPELINE_HPCX_ROOT=/sdf/group/ssrl/sarangi/sw/hpcx-v2.19
PIPELINE_GCC_ROOT=/sdf/group/epptheory/Programs/gcc-12
PIPELINE_ORCA_HOME=/sdf/group/ssrl/sarangi/sw/orca601/orca_6_0_1/
# dym2feffinp helper shipped with the FEFF10 install (used by prepare-corvus.py)
DYM2FEFFINP_BIN=/sdf/home/t/tetef01/software/feff10-10.0.0/bin/MPI/dym2feffinp
# Full path to run-corvus (otherwise the templates probe .venv / conda / PATH)
# CORVUS_RUNNER=/sdf/home/t/tetef01/working-station/automated-pipeline/.venv/bin/run-corvus

# Scheduler backend (pbs | slurm). Also settable via PIPELINE_SCHEDULER on the CLI.
# PIPELINE_SCHEDULER=slurm

# ============================================================================
# PBS (old cluster) -- the defaults that were on main; uncomment to use
# ============================================================================
# PBS uses environment-modules for MPI/compilers, so only these paths matter:
# PIPELINE_ORCA_HOME=/opt/bin
# PIPELINE_SCRATCH_ROOT=/home/stetef/working-station/scratch
# CORVUS_RUNNER=$HOME/.conda/envs/corvusenv/bin/run-corvus
# PIPELINE_SCHEDULER=pbs
