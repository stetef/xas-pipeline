#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --job-name=prep-corvus-4j1v_cluster2_Zn-xtb-free-xas
#SBATCH --output=prep-corvus-4j1v_cluster2_Zn-xtb-free-xas.sout
#SBATCH --error=prep-corvus-4j1v_cluster2_Zn-xtb-free-xas.serr
#SBATCH --chdir=.

set -euo pipefail

RUN_DIR="<OUT>/4j1v_cluster2_Zn/4j1v_cluster2_Zn-xtb-free"
RUN_ID="4j1v_cluster2_Zn-xtb-free"
CORVUS_MODE=xas
OPTIMIZATION_MODE=xtb-free
SPRING_HESSIAN=0

PIPELINE_ROOT="<REPO>"
PIPELINE_ENV="<REPO>/.env"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi
export PIPELINE_ROOT
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"; fi

# FEFF10 and its helper dym2feffinp (run by prepare-corvus) were built against
# the group OpenMPI and Mellanox HCOLL, which the compute nodes lack; point at the
# shared copies before prepare-corvus runs. Keep in sync with corvus-job.script.
: "${PIPELINE_OPENMPI_ROOT:=/path/to/openmpi}"
: "${PIPELINE_HPCX_ROOT:=/path/to/hpcx}"
export PATH="$PIPELINE_OPENMPI_ROOT/bin:${PATH}"
export LD_LIBRARY_PATH="$PIPELINE_OPENMPI_ROOT/lib:$PIPELINE_HPCX_ROOT/hcoll/lib:${LD_LIBRARY_PATH:-}"
export OMPI_MCA_coll_hcoll_enable=0
export OMPI_MCA_osc=^ucx
export UCX_LOG_LEVEL=error

# The interpreter that generated this script; $PIPELINE_PYTHON overrides it.
PYTHON_BIN="${PIPELINE_PYTHON:-<PYTHON>}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python interpreter not found: $PYTHON_BIN (set PIPELINE_PYTHON)" >&2
  exit 127
fi

cd "$RUN_DIR"

start_epoch=$(date +%s)
timing_file="$RUN_DIR/$RUN_ID-corvus-${CORVUS_MODE}.timing"
echo "start_epoch=$start_epoch" > "$timing_file"
echo "hostname=$(hostname)" >> "$timing_file"

# Always finalize the timing file (end_epoch/elapsed_seconds/exit_code), even on
# failure: a .timing file with no exit_code reads as "never finished".
finalize_timing() {
  local status=$1
  local end_epoch elapsed
  end_epoch=$(date +%s)
  elapsed=$((end_epoch - start_epoch))
  echo "end_epoch=$end_epoch" >> "$timing_file"
  echo "elapsed_seconds=$elapsed" >> "$timing_file"
  echo "exit_code=$status" >> "$timing_file"
}

# Stop aborting on the first non-zero exit so we can attach an informative
# diagnostic and still finalize the timing file before exiting.
set +e

hess_file="$RUN_DIR/$RUN_ID.hess"

# Hessian source. For ORCA AnFreq modes $RUN_ID.hess already exists and this is a
# no-op (`true`). For the spring modes it interpolates the Hessian from the ligand
# spring models (the run dir's interp-ligands/ if present, else the packaged ones)
# and writes $RUN_ID.hess, so prepare-corvus finds what it expects either way.
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Hessian step for $RUN_ID (orca mode=$OPTIMIZATION_MODE)"
true
interp_status=$?
if [[ $interp_status -ne 0 ]]; then
  {
    echo "ERROR: could not build the interpolated Hessian for $RUN_ID, exit code $interp_status."
    echo "       Mode '$OPTIMIZATION_MODE' runs no ORCA AnFreq, so there is no .hess to fall"
    echo "       back on and CORVUS cannot build the FEFF dynamical matrix."
    echo "       See the traceback above; check that the cluster's ligands are covered by the"
    echo "       .interp models it used and that $RUN_ID.xyz is a complete geometry."
  } >&2
  finalize_timing "$interp_status"
  exit "$interp_status"
fi

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Starting prepare-corvus for $RUN_ID (mode=$CORVUS_MODE)"
echo "Using Python interpreter: $PYTHON_BIN"
"$PYTHON_BIN" --version || true
"$PYTHON_BIN" -m xas_pipeline.stages.corvus_prep "$RUN_DIR" --run-id "$RUN_ID" --scheduler slurm --corvus-mode "$CORVUS_MODE" --num-procs "${SLURM_NTASKS:-16}"
prep_status=$?
if [[ $prep_status -ne 0 ]]; then
  {
    echo "ERROR: prepare-corvus failed for $RUN_ID (mode=$CORVUS_MODE), exit code $prep_status."
    if [[ ! -f "$hess_file" ]]; then
      echo "  Cause: Hessian '$RUN_ID.hess' is missing, so CORVUS cannot build the FEFF"
      echo "         DYM (dynamical matrix)."
      if [[ "$SPRING_HESSIAN" == "1" ]]; then
        echo "         Mode '$OPTIMIZATION_MODE' takes its Hessian from the spring-model step"
        echo "         above, not from ORCA; that step reported success yet wrote no .hess."
        echo "         Re-run it by hand to see why:"
        echo "           $PYTHON_BIN -m xas_pipeline.stages.interp_hessian '$RUN_DIR' --run-id '$RUN_ID'"
      else
        echo "         A missing .hess almost always means the upstream ORCA analytic-frequency"
        echo "         (AnFreq) step did not finish. Check $RUN_DIR/$RUN_ID-orca.log for"
        echo "         'error termination' (e.g. out-of-memory in COSX RHS -> raise"
        echo "         %MaxCore/--mem, or SCF non-convergence). Re-run ORCA to produce the"
        echo "         .hess, then retry CORVUS."
      fi
    else
      echo "  The Hessian is present, so this is a CORVUS/FEFF input-preparation error rather"
      echo "  than a missing-.hess problem -- see the Python traceback above."
    fi
  } >&2
  finalize_timing "$prep_status"
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] prepare-corvus exit code: $prep_status"
  exit "$prep_status"
fi

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] prepare-corvus complete; running CORVUS for $RUN_ID (mode=$CORVUS_MODE)"
corvus_job_script="$RUN_DIR/corvus-job-${CORVUS_MODE}.script"
if [[ ! -f "$corvus_job_script" ]]; then
  echo "ERROR: missing generated CORVUS job script $corvus_job_script" >&2
  finalize_timing 2
  exit 2
fi

# Execute generated corvus script inline (not nested scheduler submission).
# The generated script uses SLURM_SUBMIT_DIR, so point it to this run directory.
export SLURM_SUBMIT_DIR="$RUN_DIR"
bash "$corvus_job_script"
run_status=$?

finalize_timing "$run_status"
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] CORVUS inline script exit code: $run_status"
if [[ $run_status -ne 0 ]]; then
  echo "ERROR: CORVUS/FEFF run failed for $RUN_ID (mode=$CORVUS_MODE), exit code $run_status." >&2
  echo "       Inspect the CORVUS working directory and feff.inp under $RUN_DIR for details." >&2
fi
exit $run_status
