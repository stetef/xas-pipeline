#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --time=168:00:00
#SBATCH --ntasks=16
#SBATCH --job-name=orca-4j1v_cluster2_Zn-hopt-spring
#SBATCH --output=orca-4j1v_cluster2_Zn-hopt-spring.sout
#SBATCH --error=orca-4j1v_cluster2_Zn-hopt-spring.serr
#SBATCH --mem=23G
#SBATCH --chdir=.

# Load modules
if [[ -f /etc/profile.d/modules.sh ]]; then
  # Initialize environment-modules for non-interactive shells
  source /etc/profile.d/modules.sh
fi

module purge
module load slurm
module list

# Load site config (paths) from the pipeline .env if present, then fall back to
# the site defaults for anything left unset.
PIPELINE_ENV="<REPO>/.env"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi
# The interpreter that generated this script (for the auto-rerun hook below).
PYTHON_BIN="${PIPELINE_PYTHON:-<PYTHON>}"
: "${PIPELINE_OPENMPI_ROOT:=/path/to/openmpi}"
: "${PIPELINE_HPCX_ROOT:=/path/to/hpcx}"
: "${PIPELINE_GCC_ROOT:=/path/to/gcc}"

# Cluster-specific MPI/compiler/runtime paths
export PATH="$PIPELINE_OPENMPI_ROOT/bin:$PATH"
export LD_LIBRARY_PATH="$PIPELINE_OPENMPI_ROOT/lib:$LD_LIBRARY_PATH"
export PATH="$PIPELINE_HPCX_ROOT:$PATH"
export LD_LIBRARY_PATH="$PIPELINE_HPCX_ROOT/hcoll/lib:$LD_LIBRARY_PATH"
export OMPI_MCA_coll_hcoll_enable=0
export OMPI_MCA_osc=^ucx
export PATH="$PIPELINE_GCC_ROOT/bin:$PATH"
export LD_LIBRARY_PATH="$PIPELINE_GCC_ROOT/lib:$LD_LIBRARY_PATH"
export LD_LIBRARY_PATH="$PIPELINE_GCC_ROOT/lib64:$LD_LIBRARY_PATH"

shopt -s extglob nullglob

export SLURM_SUBMIT_DIR=${SLURM_SUBMIT_DIR:-$PWD}
export SLURM_SUBMIT_HOST=${SLURM_SUBMIT_HOST:-$(hostname)}

# Reduce UCX verbosity
export UCX_LOG_LEVEL=error

: "${PIPELINE_ORCA_HOME:=/path/to/orca}"
export ORCA_HOME="$PIPELINE_ORCA_HOME"
export PATH="$ORCA_HOME:$PATH"
export LD_LIBRARY_PATH="$ORCA_HOME:$LD_LIBRARY_PATH"
ORCA_EXEC="$ORCA_HOME/orca"
if [[ ! -x "$ORCA_EXEC" ]]; then
  echo "ORCA not found at $ORCA_EXEC" >&2
  exit 1
fi

# Node scratch (node-env.sh): ORCA computes in a per-job dir under /lscratch with a heartbeat, so a later job on
# this node can delete it if this one dies without cleaning up. Its log is written there too and copied to the run
# dir every XAS_LOG_SYNC_S (300 s, only when it grew): the watchdog judges liveness by that file's mtime plus CPU
# time, and its idle threshold (1 h) is far above the sync interval. Every XAS_ORCA_CHECKPOINT_S (1800 s), and on
# TERM/INT (preemption, scancel, time limit), the restart files -- geometry, trajectory, .opt, .gbw -- are copied to
# the run dir's orca-checkpoint/, so a killed or crashed optimisation can be restarted from its last geometry
# instead of from scratch. A node that dies loses at most the last checkpoint interval.
source "<REPO>/src/xas_pipeline/data/sw/node-env.sh"
submit_log=$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.log
ckpt_dir=$SLURM_SUBMIT_DIR/orca-checkpoint
if xas_scratch_make "orca-4j1v_cluster2_Zn-hopt-spring"; then
  tdir=$XAS_SCRATCH_DIR
  logfile=$tdir/4j1v_cluster2_Zn-hopt-spring-orca.log
else
  # Old behaviour: scratch under $TMPDIR, log streamed straight to the run dir.
  logfile=$submit_log
  scratch_root="${SLURM_TMPDIR:-${TMPDIR:-$PWD/scratch}}"
  mkdir -p "$scratch_root"
  tdir=$(mktemp -d "$scratch_root"/orca-run-4j1v_cluster2_Zn-hopt-spring__XXXXXX)
  if [[ -z "$tdir" || ! -d "$tdir" ]]; then
    echo "Failed to create scratch run directory under $scratch_root" >&2
    exit 1
  fi
fi

sync_log() {
  [[ "$logfile" == "$submit_log" || ! -f "$logfile" ]] && return 0
  local now
  now=$(stat -c %s "$logfile" 2>/dev/null)
  [[ "$now" == "${_synced_size:-}" ]] && return 0
  xas_put "$logfile" "$SLURM_SUBMIT_DIR" && _synced_size=$now
}
checkpoint() {
  local f
  mkdir -p "$ckpt_dir" 2>/dev/null || return 0
  for f in "$tdir"/4j1v_cluster2_Zn-hopt-spring.xyz "$tdir"/4j1v_cluster2_Zn-hopt-spring_trj.xyz "$tdir"/4j1v_cluster2_Zn-hopt-spring.opt "$tdir"/4j1v_cluster2_Zn-hopt-spring.gbw; do
    [[ -f "$f" ]] && xas_put "$f" "$ckpt_dir"
  done
  date -u +%FT%TZ > "$ckpt_dir/.when"
}
bg_pids=()
start_background() {
  ( while sleep "${XAS_LOG_SYNC_S:-300}"; do sync_log; done ) </dev/null >/dev/null 2>&1 &
  bg_pids+=($!)
  ( while sleep "${XAS_ORCA_CHECKPOINT_S:-1800}"; do checkpoint; done ) </dev/null >/dev/null 2>&1 &
  bg_pids+=($!)
}
stop_background() { local p; for p in "${bg_pids[@]}"; do kill "$p" 2>/dev/null; done; bg_pids=(); }

# A cancel, preemption or time limit sends TERM to this shell only (not to ORCA; checked 2026-11-13), so ORCA runs
# in the background in its own process group and the trap stops it -- with its MPI ranks -- before saving.
orca_pid=
trap '
echo "Job terminated from outer space!" >> $logfile
if [[ -n "$orca_pid" ]]; then
  kill -TERM -- "-$orca_pid" 2>/dev/null
  for _ in 1 2 3 4 5; do kill -0 -- "-$orca_pid" 2>/dev/null || break; sleep 1; done
  kill -KILL -- "-$orca_pid" 2>/dev/null
fi
stop_background
checkpoint
sync_log
if [[ -n "$XAS_SCRATCH_DIR" ]]; then xas_scratch_drop; else rm -rf "$tdir"; fi
exit
' TERM INT

cp "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring.in" "$tdir"
for f in "$SLURM_SUBMIT_DIR"/*.gbw "$SLURM_SUBMIT_DIR"/*.pot; do
  [[ -e "$f" ]] || continue
  cp "$f" "$tdir"
done
cd "$tdir"

# Ensure mpirun exists if module only provides mpiexec
MPIEXEC=$(command -v mpirun || command -v mpiexec || true)
if [[ -z "$MPIEXEC" ]]; then
  echo "mpirun/mpiexec not found in PATH" >> $logfile
  exit 1
fi
MPI_DIR=$(dirname "$MPIEXEC")
if [[ ! -x "$MPI_DIR/mpirun" && -x "$MPI_DIR/mpiexec" ]]; then
  mkdir -p "$tdir/mpi-bin"
  ln -s "$MPI_DIR/mpiexec" "$tdir/mpi-bin/mpirun"
  export PATH="$tdir/mpi-bin:$MPI_DIR:$PATH"
  echo "Created mpirun shim -> mpiexec in $tdir/mpi-bin" >> $logfile
fi

echo "Job started from ${SLURM_SUBMIT_HOST}, running on $(hostname) in $tdir using $ORCA_EXEC" > $logfile
echo "--- MODULES ---" >> $logfile
module list 2>> $logfile
echo "--- MODULE SHOW (slurm) ---" >> $logfile
module show slurm 2>> $logfile
echo "--- MPI ---" >> $logfile
echo "PATH=$PATH" >> $logfile
which mpirun >> $logfile 2>&1
which mpiexec >> $logfile 2>&1

start_epoch=$(date +%s)
start_background
echo "start_epoch=$start_epoch" > "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
echo "hostname=$(hostname)" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"

setsid "$ORCA_EXEC" "4j1v_cluster2_Zn-hopt-spring.in" 1>>"$logfile" 2>&1 &
orca_pid=$!
wait "$orca_pid"
orca_status=$?
orca_pid=
stop_background
end_epoch=$(date +%s)
elapsed=$((end_epoch - start_epoch))
echo "end_epoch=$end_epoch" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
echo "elapsed_seconds=$elapsed" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
echo "exit_code=$orca_status" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
if [[ $orca_status -ne 0 ]]; then
  echo "ORCA exited with code $orca_status" >> "$logfile"
fi

# ORCA's top-level launcher can return 0 even when a sub-module error-terminates
# (e.g. the analytic-frequency/PROPINT step running out of COSX memory), so the
# raw exit code is NOT a reliable success signal. Scan the log for the decisive
# markers, record a truthful status in the .timing file, and emit a specific,
# actionable message to stderr (this .serr) so the failure is obvious immediately.
#
# NOTE: we deliberately do NOT flip the job's exit code here. The dependent CORVUS
# job is submitted with afterok on this job and the batch postprocess with afterany
# on CORVUS; forcing a non-zero exit would cancel CORVUS (DependencyNeverSatisfied)
# and could cascade to cancel the whole-batch postprocess. Authoritative
# pass/fail classification happens in the postprocess convergence check instead.
detail=""
orca_failed=0
if grep -q '\*\*\*\*ORCA TERMINATED NORMALLY\*\*\*\*' "$logfile"; then
  echo "terminated_normally=true" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
else
  orca_failed=1
  if grep -q 'is odd and number of electrons' "$logfile"; then
    detail="charge/multiplicity impossible for the electron count -- fix CHARGE/MULT in 4j1v_cluster2_Zn-hopt-spring.in (or the carved cluster)"
  elif grep -q 'No memory left for COSX' "$logfile" || grep -q 'Increase the %MAXCORE' "$logfile"; then
    detail="out of memory in the RIJCOSX build (typically the AnFreq step) -- raise %MaxCore and/or SBATCH --mem, then resubmit"
  elif grep -q 'SCF has not converged' "$logfile" || grep -q 'SCF NOT CONVERGED' "$logfile"; then
    detail="SCF did not converge -- try SlowConv/NRSCF, a better initial guess, or a looser target"
  elif grep -qE 'ORCA finished by error termination in [A-Za-z0-9_]+' "$logfile"; then
    detail="$(grep -oE 'ORCA finished by error termination in [A-Za-z0-9_]+' "$logfile" | tail -1)"
  else
    detail="ORCA did not terminate normally (crashed or was killed mid-run; check MaxRSS for OOM)"
  fi
  echo "terminated_normally=false" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
  echo "status_detail=\"$detail\"" >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-orca.timing"
  {
    echo "ERROR: ORCA run 4j1v_cluster2_Zn-hopt-spring did not terminate normally: $detail"
    echo "       No '****ORCA TERMINATED NORMALLY****' in $logfile."
    echo "       If a Hessian (.hess) was expected, it was not produced, so the dependent"
    echo "       CORVUS/FEFF job will fail with a missing-Hessian error."
  } >&2
fi

# The log first (it is what every later stage reads), then everything else in one copy. The checkpoint is only a
# restart aid: once the results are back it is removed.
_synced_size=
sync_log
cp !(*.in|*.inp|*.tmp*|.heartbeat|4j1v_cluster2_Zn-hopt-spring-orca.log|*.densities|*.densitiesinfo|*.cpcm|*.cpcm_corr|*.engrad|*.bin) "$SLURM_SUBMIT_DIR"/ && rm -rf "$ckpt_dir"
cd "$SLURM_SUBMIT_DIR"
if [[ -n "$XAS_SCRATCH_DIR" ]]; then xas_scratch_drop; else rm -rf "$tdir"; fi

# Auto-rerun triage: on failure, xas-rerun-orca diagnoses the log and, for an
# out-of-memory kill or an optimization out of cycles, resubmits ORCA with the
# remedy plus a fresh dependent CORVUS job; anything else is escalated to a human.
# It fires the moment a run fails, not at the batch postprocess. Disable with
# XAS_AUTO_RERUN=0.
if [[ "$orca_failed" == "1" && "${XAS_AUTO_RERUN:-1}" != "0" && -x "$PYTHON_BIN" ]]; then
  echo "auto-rerun: triaging failed ORCA run 4j1v_cluster2_Zn-hopt-spring" >&2
  "$PYTHON_BIN" -m xas_pipeline.cli.rerun_orca "$SLURM_SUBMIT_DIR" --scheduler slurm \
    >> "$SLURM_SUBMIT_DIR/4j1v_cluster2_Zn-hopt-spring-rerun.log" 2>&1 || true
fi

exit $orca_status
