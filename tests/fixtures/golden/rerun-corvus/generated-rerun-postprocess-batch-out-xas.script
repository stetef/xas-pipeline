#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --job-name=postproc-batch-out
#SBATCH --output=postproc-batch-out.sout
#SBATCH --error=postproc-batch-out.serr
#SBATCH --chdir=.

set -euo pipefail

PIPELINE_ROOT="<REPO>"
PIPELINE_ENV="<REPO>/.env"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi
export PIPELINE_ROOT
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"; fi

# The interpreter that generated this script; $PIPELINE_PYTHON overrides it.
PYTHON_BIN="${PIPELINE_PYTHON:-<REPO>/.venv/bin/python}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python interpreter not found: $PYTHON_BIN (set PIPELINE_PYTHON)" >&2
  exit 127
fi
echo "Using Python interpreter: $PYTHON_BIN"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Postprocess start for <BATCH>"
cd "<BATCH>"

true
"$PYTHON_BIN" -m xas_pipeline.stages.feff_process "<BATCH>" --recursive
"$PYTHON_BIN" -m xas_pipeline.stages.cleanup "<BATCH>" --execute

# CORVUS auto-rerun triage: recomputes runs whose XANES leg came back dead (chi
# identically zero, a sporadic failure) and drops them from corvus-failed-ids.txt,
# so the download stage leaves their run dirs in place for the queued job. Runs
# after cleanup so nothing prunes a recompute mid-flight. Never fails the
# postprocess: if triage errors, those ids stay quarantined.
"$PYTHON_BIN" -m xas_pipeline.cli.auto_rerun_corvus "<BATCH>" --scheduler slurm --download-destination "<BATCH>/downloading-station" || echo "warning: CORVUS auto-rerun triage failed; leaving failed ids quarantined" >&2

"$PYTHON_BIN" -m xas_pipeline.stages.download "<BATCH>" -d "<BATCH>/downloading-station" --refresh
"$PYTHON_BIN" -m xas_pipeline.stages.stage_times "<BATCH>"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Postprocess complete for <BATCH>"
