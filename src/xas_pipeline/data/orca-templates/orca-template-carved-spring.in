! PBE0 D3BJ RIJCOSX def2-TZVP def2/J CPCM(water)

# Single point for the energy ONLY -- no analytic frequencies.
# The Hessian this run would otherwise produce is instead interpolated from the
# packaged ligand spring models by xas_pipeline.stages.interp_hessian, which the
# corvus wrapper runs before prepare-corvus and which writes the same
# <run_id>.hess the CORVUS/FEFF stage expects.
#
# [ANFREQ] below is filled by prepare-orca and defaults to OFF for this mode
# (the anfreq field of xas_pipeline.modes). Forcing it on with --anfreq would not break anything,
# but it would spend the analytic-frequency time that this mode exists to avoid,
# and its .hess would then be overwritten by the interpolated one.

[ANFREQ]

! 6-311++G(d,p)
! ZORA ZORA-def2-TZVP SARC/J

%basis
  NewGTO Zn "def2-TZVPP" end
end

# Per-process memory in MB, sized by prepare-orca.py from the atom count
%maxcore [MAXCORE]

# Specify numnber of processors
%pal nprocs 16
  end

# Use xyz file, first number is charge, second number is multiplicity (2S+1)
*xyzfile [CHARGE] [MULTIPLICITY] [GEOMETRY]
