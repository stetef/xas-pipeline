#!/bin/bash
#PBS -l nodes=1:ppn=16
#PBS -S /bin/bash
#PBS -N prep-corvus-[RUN_ID]-[CORVUS_MODE]
#PBS -q workq
#PBS -V
#PBS -o prep-corvus-[RUN_ID]-[CORVUS_MODE].sout
#PBS -e prep-corvus-[RUN_ID]-[CORVUS_MODE].serr

set -euo pipefail

RUN_DIR=[RUN_DIR]
RUN_ID=[RUN_ID]
PREP_CORVUS=[PREP_CORVUS]
CORVUS_MODE=[CORVUS_MODE]

# Load site config (e.g. DYM2FEFFINP_BIN, CORVUS_RUNNER) from the pipeline .env so
# prepare-corvus.py and the inline corvus job inherit it.
PIPELINE_ENV="[PIPELINE_ENV]"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi

cd "$RUN_DIR"

start_epoch=$(date +%s)
timing_file="$RUN_DIR/$RUN_ID-corvus-${CORVUS_MODE}.timing"
echo "start_epoch=$start_epoch" > "$timing_file"
echo "hostname=$(hostname)" >> "$timing_file"

# Always finalize the timing file (end_epoch/elapsed_seconds/exit_code) before we
# exit, even on failure. Previously the script ran under `set -e`, so a failing
# prepare-corvus/CORVUS step aborted the script BEFORE these lines ran and left the
# .timing file truncated (start_epoch + hostname only) with no exit_code -- which
# is exactly why past CORVUS failures looked like they "never finished".
finalize_timing() {
  local status=$1
  local end_epoch elapsed
  end_epoch=$(date +%s)
  elapsed=$((end_epoch - start_epoch))
  echo "end_epoch=$end_epoch" >> "$timing_file"
  echo "elapsed_seconds=$elapsed" >> "$timing_file"
  echo "exit_code=$status" >> "$timing_file"
}

# Stop aborting on the first non-zero exit so we can attach an informative
# diagnostic and still finalize the timing file before exiting.
set +e

hess_file="$RUN_DIR/$RUN_ID.hess"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Starting prepare-corvus for $RUN_ID (mode=$CORVUS_MODE)"
python "$PREP_CORVUS" "$RUN_DIR" --run-id "$RUN_ID" --scheduler [SCHEDULER] --corvus-mode "$CORVUS_MODE" --num-procs "${PBS_NUM_PPN:-16}"
prep_status=$?
if [[ $prep_status -ne 0 ]]; then
  {
    echo "ERROR: prepare-corvus failed for $RUN_ID (mode=$CORVUS_MODE), exit code $prep_status."
    if [[ ! -f "$hess_file" ]]; then
      echo "  Cause: ORCA Hessian '$RUN_ID.hess' is missing, so CORVUS cannot build the FEFF"
      echo "         DYM (dynamical matrix). A missing .hess almost always means the upstream"
      echo "         ORCA analytic-frequency (AnFreq) step did not finish. Check"
      echo "         $RUN_DIR/$RUN_ID-orca.log for 'error termination' (e.g. out-of-memory in"
      echo "         COSX RHS -> raise %MaxCore/--mem, or SCF non-convergence). Re-run ORCA to"
      echo "         produce the .hess, then retry CORVUS."
    else
      echo "  The Hessian is present, so this is a CORVUS/FEFF input-preparation error rather"
      echo "  than a missing-.hess problem -- see the Python traceback above."
    fi
  } >&2
  finalize_timing "$prep_status"
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] prepare-corvus exit code: $prep_status"
  exit "$prep_status"
fi

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] prepare-corvus complete; running CORVUS for $RUN_ID (mode=$CORVUS_MODE)"
corvus_job_script="$RUN_DIR/corvus-job-${CORVUS_MODE}.script"
if [[ ! -f "$corvus_job_script" ]]; then
  echo "ERROR: missing generated CORVUS job script $corvus_job_script" >&2
  finalize_timing 2
  exit 2
fi

# Execute generated corvus script inline (not nested scheduler submission).
# The generated script uses PBS_O_WORKDIR, so point it to this run directory.
export PBS_O_WORKDIR="$RUN_DIR"
bash "$corvus_job_script"
run_status=$?

finalize_timing "$run_status"
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] CORVUS inline script exit code: $run_status"
if [[ $run_status -ne 0 ]]; then
  echo "ERROR: CORVUS/FEFF run failed for $RUN_ID (mode=$CORVUS_MODE), exit code $run_status." >&2
  echo "       Inspect the CORVUS working directory and feff.inp under $RUN_DIR for details." >&2
fi
exit $run_status
