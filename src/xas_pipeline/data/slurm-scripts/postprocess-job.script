#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --job-name=postproc-[BATCH_NAME]
#SBATCH --output=postproc-[BATCH_NAME].sout
#SBATCH --error=postproc-[BATCH_NAME].serr
#SBATCH --chdir=.

set -euo pipefail

# Resolve the interpreter ourselves rather than trusting the submitting shell's
# PATH. Slurm exports the submit environment, so a bare `python` "works" only when
# the batch was submitted from an activated venv -- submit by calling
# .venv/bin/xas-* at its absolute path instead and every stage below dies with
# "python: command not found" (exit 127) before doing anything. Same resolution
# order as corvus-wrapper.script; keep the two in sync.
PIPELINE_ROOT=[PIPELINE_ROOT]
PIPELINE_ENV="[PIPELINE_ENV]"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi

export PIPELINE_ROOT
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then
  export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"
fi

if [[ -n "${PIPELINE_PYTHON:-}" ]]; then
  PYTHON_BIN="$PIPELINE_PYTHON"
elif [[ -x "$PIPELINE_ROOT/.venv/bin/python" ]]; then
  PYTHON_BIN="$PIPELINE_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python)"
else
  echo "No usable Python interpreter found for the postprocess stages" >&2
  exit 127
fi
echo "Using Python interpreter: $PYTHON_BIN"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Postprocess start for [OUTPUT_ROOT]"
cd "[OUTPUT_ROOT]"

[EXTRACT_CMD]
[PROCESS_FEFF_CMD]
[CLEANUP_CMD]

# CORVUS auto-rerun triage. Recomputes the runs whose XANES leg came back dead
# (chi identically zero -- a sporadic failure that clears on a retry) and drops
# them from corvus-failed-ids.txt so the download stage below leaves their run
# dirs in place for the queued job. Runs after the cleanup pass so nothing prunes
# a recompute mid-flight. Never allowed to fail the postprocess: if triage errors,
# those ids simply stay quarantined, exactly as before this stage existed.
[AUTO_RERUN_CORVUS_CMD] || echo "warning: CORVUS auto-rerun triage failed; leaving failed ids quarantined" >&2

[PREPARE_DOWNLOAD_CMD]

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Postprocess complete for [OUTPUT_ROOT]"
"$PYTHON_BIN" - <<'PY'
import csv
from pathlib import Path

base = Path(r"[OUTPUT_ROOT]")
out_csv = base / 'pipeline-stage-times.csv'
skip_dirs = {'failed-orca', 'failed-corvus', 'downloading-station', 'xyz_files', 'optimized_xyz_files'}
rows = []
for run_dir in sorted(p for p in base.iterdir() if p.is_dir() and p.name not in skip_dirs):
    run_id = run_dir.name
    timings = {'run_id': run_id}
    for stage, suffix in [('orca', f'{run_id}-orca.timing'), ('corvus', f'{run_id}-corvus.timing')]:
        tpath = run_dir / suffix
        if not tpath.is_file():
            timings[f'{stage}_elapsed_seconds'] = ''
            timings[f'{stage}_exit_code'] = ''
            continue
        parsed = {}
        for raw in tpath.read_text(encoding='utf-8', errors='replace').splitlines():
            if '=' not in raw:
                continue
            key, value = raw.split('=', 1)
            parsed[key.strip()] = value.strip()
        timings[f'{stage}_elapsed_seconds'] = parsed.get('elapsed_seconds', '')
        timings[f'{stage}_exit_code'] = parsed.get('exit_code', '')
    rows.append(timings)

with out_csv.open('w', newline='', encoding='utf-8') as fh:
    writer = csv.DictWriter(
        fh,
        fieldnames=['run_id', 'orca_elapsed_seconds', 'orca_exit_code', 'corvus_elapsed_seconds', 'corvus_exit_code'],
    )
    writer.writeheader()
    writer.writerows(rows)

print(f'Wrote timing summary: {out_csv}')
PY
