#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --job-name=postproc-[BATCH_NAME]
#SBATCH --output=postproc-[BATCH_NAME].sout
#SBATCH --error=postproc-[BATCH_NAME].serr
#SBATCH --chdir=.

set -euo pipefail

PIPELINE_ROOT="[PIPELINE_ROOT]"
PIPELINE_ENV="[PIPELINE_ENV]"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi
export PIPELINE_ROOT
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"; fi

# The interpreter that generated this script; $PIPELINE_PYTHON overrides it.
PYTHON_BIN="${PIPELINE_PYTHON:-[PYTHON]}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python interpreter not found: $PYTHON_BIN (set PIPELINE_PYTHON)" >&2
  exit 127
fi
echo "Using Python interpreter: $PYTHON_BIN"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Postprocess start for [OUTPUT_ROOT]"
cd "[OUTPUT_ROOT]"

[EXTRACT_CMD]
[PROCESS_FEFF_CMD]
[CLEANUP_CMD]

# CORVUS auto-rerun triage: recomputes runs whose XANES leg came back dead (chi
# identically zero, a sporadic failure) and drops them from corvus-failed-ids.txt,
# so the download stage leaves their run dirs in place for the queued job. Runs
# after cleanup so nothing prunes a recompute mid-flight. Never fails the
# postprocess: if triage errors, those ids stay quarantined.
[AUTO_RERUN_CORVUS_CMD] || echo "warning: CORVUS auto-rerun triage failed; leaving failed ids quarantined" >&2

[PREPARE_DOWNLOAD_CMD]
[STAGE_TIMES_CMD]

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Postprocess complete for [OUTPUT_ROOT]"
