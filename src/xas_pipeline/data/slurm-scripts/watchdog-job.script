#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=[WATCHDOG_WALLTIME]
#SBATCH --job-name=watchdog-[BATCH_NAME]
#SBATCH --output=watchdog-[BATCH_NAME].sout
#SBATCH --error=watchdog-[BATCH_NAME].serr
#SBATCH --chdir=.

set -euo pipefail

# Resolve the interpreter the same way postprocess-job.script does (keep in sync):
# Slurm exports the submit environment, so a bare `python` only works when the
# batch was submitted from an activated venv. Submit by calling .venv/bin/xas-*
# at its absolute path and this resolution is what finds Python on the node.
PIPELINE_ROOT=[PIPELINE_ROOT]
PIPELINE_ENV="[PIPELINE_ENV]"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi

export PIPELINE_ROOT
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then
  export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"
fi

if [[ -n "${PIPELINE_PYTHON:-}" ]]; then
  PYTHON_BIN="$PIPELINE_PYTHON"
elif [[ -x "$PIPELINE_ROOT/.venv/bin/python" ]]; then
  PYTHON_BIN="$PIPELINE_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python)"
else
  echo "No usable Python interpreter found for the watchdog" >&2
  exit 127
fi
echo "Using Python interpreter: $PYTHON_BIN"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Watchdog start for [OUTPUT_ROOT]"

# Polls the batch and auto-resubmits silently-hung ORCA jobs. Exits 0 once the
# batch has no outstanding jobs. Never allowed to take the batch down with it:
# a crash here just means hangs go uncaught, exactly as before this existed.
"$PYTHON_BIN" -m xas_pipeline.cli.watchdog "[OUTPUT_ROOT]" \
  --scheduler [SCHEDULER] \
  --interval [WATCHDOG_INTERVAL] \
  --idle-threshold [WATCHDOG_IDLE_THRESHOLD] \
  --max-reruns [WATCHDOG_MAX_RERUNS] || \
  echo "warning: watchdog exited non-zero; hangs will not be auto-recovered" >&2

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Watchdog complete for [OUTPUT_ROOT]"
