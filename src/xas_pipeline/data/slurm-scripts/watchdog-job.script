#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=[WATCHDOG_WALLTIME]
#SBATCH --job-name=watchdog-[BATCH_NAME]
#SBATCH --output=watchdog-[BATCH_NAME].sout
#SBATCH --error=watchdog-[BATCH_NAME].serr
#SBATCH --chdir=.

set -euo pipefail

PIPELINE_ROOT="[PIPELINE_ROOT]"
PIPELINE_ENV="[PIPELINE_ENV]"
if [[ -f "$PIPELINE_ENV" ]]; then set -a; source "$PIPELINE_ENV"; set +a; fi
export PIPELINE_ROOT
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"; fi

# The interpreter that generated this script; $PIPELINE_PYTHON overrides it.
PYTHON_BIN="${PIPELINE_PYTHON:-[PYTHON]}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Python interpreter not found: $PYTHON_BIN (set PIPELINE_PYTHON)" >&2
  exit 127
fi
echo "Using Python interpreter: $PYTHON_BIN"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Watchdog start for [OUTPUT_ROOT]"

# Polls the batch and resubmits silently hung ORCA/CORVUS jobs; exits 0 once the
# batch has no outstanding jobs. A crash here only means hangs go uncaught.
"$PYTHON_BIN" -m xas_pipeline.cli.watchdog "[OUTPUT_ROOT]" \
  --scheduler [SCHEDULER] \
  --interval [WATCHDOG_INTERVAL] \
  --idle-threshold [WATCHDOG_IDLE_THRESHOLD] \
  --max-reruns [WATCHDOG_MAX_RERUNS] || \
  echo "warning: watchdog exited non-zero; hangs will not be auto-recovered" >&2

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Watchdog complete for [OUTPUT_ROOT]"
