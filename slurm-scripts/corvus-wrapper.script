#!/bin/bash
#SBATCH --partition=milano
#SBATCH --account=ssrl:SMBXAS
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --job-name=prep-corvus-[CORVUS_MODE]-[RUN_ID]
#SBATCH --output=prep-corvus-[CORVUS_MODE]-[RUN_ID].sout
#SBATCH --error=prep-corvus-[CORVUS_MODE]-[RUN_ID].serr
#SBATCH --chdir=.

set -euo pipefail

RUN_DIR=[RUN_DIR]
RUN_ID=[RUN_ID]
PREP_CORVUS=[PREP_CORVUS]
CORVUS_MODE=[CORVUS_MODE]
export PIPELINE_ROOT=$(cd "$(dirname "$PREP_CORVUS")" && pwd)
if [[ -d "$PIPELINE_ROOT/.venv/bin" ]]; then
  export PATH="$PIPELINE_ROOT/.venv/bin:$PATH"
fi

if [[ -n "${PIPELINE_PYTHON:-}" ]]; then
  PYTHON_BIN="$PIPELINE_PYTHON"
elif [[ -x "$PIPELINE_ROOT/.venv/bin/python" ]]; then
  PYTHON_BIN="$PIPELINE_ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python)"
else
  echo "No usable Python interpreter found for $PREP_CORVUS" >&2
  exit 127
fi

cd "$RUN_DIR"

start_epoch=$(date +%s)
timing_file="$RUN_DIR/$RUN_ID-corvus-$CORVUS_MODE.timing"
echo "start_epoch=$start_epoch" > "$timing_file"
echo "hostname=$(hostname)" >> "$timing_file"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Starting prepare-corvus for $RUN_ID (mode: $CORVUS_MODE)"
echo "Using Python interpreter: $PYTHON_BIN"
"$PYTHON_BIN" --version || true
"$PYTHON_BIN" "$PREP_CORVUS" "$RUN_DIR" --scheduler [SCHEDULER] --num-procs "${SLURM_NTASKS:-16}" --corvus-mode "$CORVUS_MODE"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] prepare-corvus complete; running CORVUS ($CORVUS_MODE) for $RUN_ID"
job_script="$RUN_DIR/corvus-${CORVUS_MODE}-job.script"
if [[ ! -f "$job_script" ]]; then
  echo "Missing corvus job script: $job_script" >&2
  exit 2
fi

export SLURM_SUBMIT_DIR="$RUN_DIR"
bash -l "$job_script"
run_status=$?

end_epoch=$(date +%s)
elapsed=$((end_epoch - start_epoch))
echo "end_epoch=$end_epoch" >> "$timing_file"
echo "elapsed_seconds=$elapsed" >> "$timing_file"
echo "exit_code=$run_status" >> "$timing_file"
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] CORVUS $CORVUS_MODE exit code: $run_status"
exit $run_status
